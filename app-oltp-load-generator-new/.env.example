# SQL Server Database Configuration for OLTP Application (APP1)
# Copy this file to .env and update with your actual credentials
#
# ============================================================
# APM-to-QPM LINKING SETUP
# ============================================================
# For New Relic to link APM transactions to SQL Server QPM:
# 1. Set your NEW_RELIC_LICENSE_KEY below
# 2. Ensure DB_URL includes explicit host:port and databaseName
# 3. The newrelic.yml already has these critical settings enabled:
#    - datastore_tracer.instance_reporting.enabled: true
#    - datastore_tracer.database_name_reporting.enabled: true
#    - transaction_tracer.record_sql: obfuscated
#    - sql_metadata_comments: nr_service_guid
# 4. On the SQL Server side, ensure New Relic Database Monitoring
#    (or Infrastructure mssql integration) is collecting query stats
# ============================================================

# Database Connection - MUST include host:port and databaseName for QPM linking
DB_URL=jdbc:sqlserver://YOUR_SQL_SERVER_HOST:1433;databaseName=loadtest;encrypt=false;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=YourPassword123!

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=3

# Application Settings
THREADS=3

# New Relic Configuration - REQUIRED for APM-to-QPM linking
NEW_RELIC_LICENSE_KEY=your_license_key_here
NEW_RELIC_APP_NAME=APP1
NEW_RELIC_LOG_LEVEL=info
